      "fieldNotes": [
        {
          "title": "Text classification",
          "text": "Document classification is the task of assigning a document to one or more classes, such as sorting articles by subject.",
          "source": {
            "title": "Wikipedia: Document classification",
            "url": "https://en.wikipedia.org/wiki/Document_classification"
          }
        },
        {
          "title": "Bags of words",
          "text": "The bag-of-words model describes text by word counts and disregards word order, which makes it fast and often enough for simple jobs like classifying documents.",
          "source": {
            "title": "Wikipedia: Bag-of-words model",
            "url": "https://en.wikipedia.org/wiki/Bag-of-words_model"
          }
        },
        {
          "title": "Rare words",
          "text": "tf-idf weighs a word by how often it appears in a document and how rare it is across a collection of documents.",
          "source": {
            "title": "Wikipedia: tf-idf",
            "url": "https://en.wikipedia.org/wiki/Tf%E2%80%93idf"
          }
        }
      ],
      "debrief": {
        "summary": [
          "You turned notes into word counts, saw why rare words count for more, scored a review by adding word weights, and checked accuracy on texts the model had not seen.",
          "Wren stacks the sorted notes into two baskets. \"Praise on the left. Grumbles on the right. And a few that need a human.\""
        ],
        "mistake": {
          "title": "Trusting a score on words it never saw",
          "text": "A classifier can only use words it learned about. New words add nothing, so check it on fresh texts, not just the ones it was built from."
        }
      }
    }
